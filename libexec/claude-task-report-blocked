#!/bin/bash
# claude-task report-blocked - Update project status to Blocked
set -euo pipefail

CONTEXT_FILE=".claude-task-context.json"

# Check for reason argument
if [[ $# -lt 1 ]]; then
  echo "Usage: claude-task report-blocked \"<reason>\"" >&2
  exit 1
fi

REASON="$1"

# Check context file exists
if [[ ! -f "$CONTEXT_FILE" ]]; then
  echo "Error: Context file not found: $CONTEXT_FILE" >&2
  echo "This command must be run from a claude-task worktree." >&2
  exit 1
fi

# Parse context
ISSUE_URL=$(jq -r '.issue_url' "$CONTEXT_FILE")
ISSUE_NUM=$(jq -r '.issue_num' "$CONTEXT_FILE")
REPO=$(jq -r '.repo' "$CONTEXT_FILE")
PROJECT_OWNER=$(jq -r '.project.owner' "$CONTEXT_FILE")
PROJECT_NUMBER=$(jq -r '.project.number' "$CONTEXT_FILE")
PROJECT_ID=$(jq -r '.project.id' "$CONTEXT_FILE")
STATUS_FIELD_ID=$(jq -r '.project.status_field_id' "$CONTEXT_FILE")
BLOCKED_STATUS_ID=$(jq -r '.project.blocked_status_id' "$CONTEXT_FILE")

# Add to project if not already (returns item ID)
ITEM_ID=$(gh project item-add "$PROJECT_NUMBER" --owner "$PROJECT_OWNER" --url "$ISSUE_URL" --format json 2>/dev/null | jq -r '.id') || true

if [[ -z "$ITEM_ID" || "$ITEM_ID" == "null" ]]; then
  # Already in project, find item ID
  ITEMS=$(gh project item-list "$PROJECT_NUMBER" --owner "$PROJECT_OWNER" --format json --limit 1000)
  ITEM_ID=$(echo "$ITEMS" | jq -r --arg num "$ISSUE_NUM" '.items[] | select(.content.number == ($num | tonumber)) | .id')
fi

if [[ -z "$ITEM_ID" || "$ITEM_ID" == "null" ]]; then
  echo "Error: Could not find item in project" >&2
  exit 1
fi

# Update status to Blocked
gh project item-edit --id "$ITEM_ID" --project-id "$PROJECT_ID" \
  --field-id "$STATUS_FIELD_ID" --single-select-option-id "$BLOCKED_STATUS_ID" >/dev/null

echo "Project status updated to Blocked"
echo "Reason: $REASON"

# Add comment to issue
gh issue comment "$ISSUE_NUM" --repo "$REPO" --body "Claude is blocked: $REASON" 2>/dev/null || true

# Send notification with clickable URL
"$CDO_ROOT/bin/notify-url" "Claude Blocked" "Issue #${ISSUE_NUM} needs help" "$ISSUE_URL" &

# Clean up context file
rm "$CONTEXT_FILE"
