#!/bin/bash
#
# claude-task init - Initialize project configuration
#
# Usage:
#   claude-task init <github-project-url>
#
# Example:
#   claude-task init https://github.com/users/kfly8/projects/12
#

set -e

CONFIG_FILE="$CDO_ROOT/config.sh"

usage() {
  cat <<EOF
Usage: claude-task init <github-project-url>

Example:
  claude-task init https://github.com/users/kfly8/projects/12

Required Project columns: Ready, WIP, Review, Blocked, Done
EOF
}

if [[ -z "$1" || "$1" == "-h" || "$1" == "--help" ]]; then
  usage
  exit 0
fi

PROJECT_URL="$1"

# Parse URL: https://github.com/users/USERNAME/projects/NUMBER or https://github.com/orgs/ORGNAME/projects/NUMBER
if [[ "$PROJECT_URL" =~ github\.com/users/([^/]+)/projects/([0-9]+) ]]; then
  PROJECT_OWNER="${BASH_REMATCH[1]}"
  PROJECT_NUMBER="${BASH_REMATCH[2]}"
elif [[ "$PROJECT_URL" =~ github\.com/orgs/([^/]+)/projects/([0-9]+) ]]; then
  PROJECT_OWNER="${BASH_REMATCH[1]}"
  PROJECT_NUMBER="${BASH_REMATCH[2]}"
else
  log ERROR "Invalid GitHub Project URL: $PROJECT_URL"
  exit 1
fi

log INFO "Project: $PROJECT_OWNER #$PROJECT_NUMBER"

# Check gh auth scope
if ! gh auth status 2>&1 | grep -q "project"; then
  log INFO "Adding project scope to gh auth..."
  gh auth refresh -s project
fi

log INFO "Fetching project info..."

# Get Project ID
PROJECT_ID=$(gh project view "$PROJECT_NUMBER" --owner "$PROJECT_OWNER" --format json | jq -r '.id')
if [[ -z "$PROJECT_ID" || "$PROJECT_ID" == "null" ]]; then
  log ERROR "Could not get Project ID"
  exit 1
fi
log OK "Project ID: $PROJECT_ID"

# Get Fields
log INFO "Fetching fields..."
FIELDS=$(gh project field-list "$PROJECT_NUMBER" --owner "$PROJECT_OWNER" --format json)

# Find Status field
STATUS_FIELD=$(echo "$FIELDS" | jq -r '.fields[] | select(.name == "Status")')
if [[ -z "$STATUS_FIELD" ]]; then
  log ERROR "Status field not found in project"
  exit 1
fi

STATUS_FIELD_ID=$(echo "$STATUS_FIELD" | jq -r '.id')
log OK "Status Field ID: $STATUS_FIELD_ID"

# Get option IDs
get_option_id() {
  local name="$1"
  local id=$(echo "$STATUS_FIELD" | jq -r --arg name "$name" '.options[] | select(.name == $name) | .id')
  if [[ -z "$id" || "$id" == "null" ]]; then
    log ERROR "Option '$name' not found in Status field"
    echo ""
    return 1
  fi
  echo "$id"
}

log INFO "Fetching status options..."

READY_ID=$(get_option_id "Ready") || exit 1
log OK "Ready: $READY_ID"

WIP_ID=$(get_option_id "WIP") || exit 1
log OK "WIP: $WIP_ID"

REVIEW_ID=$(get_option_id "Review") || exit 1
log OK "Review: $REVIEW_ID"

BLOCKED_ID=$(get_option_id "Blocked") || exit 1
log OK "Blocked: $BLOCKED_ID"

DONE_ID=$(get_option_id "Done") || exit 1
log OK "Done: $DONE_ID"

# Write config
log INFO "Writing config to $CONFIG_FILE..."

cat > "$CONFIG_FILE" << EOF
# claude-task configuration
# Generated by: claude-task init $PROJECT_URL
# Generated at: $(date '+%Y-%m-%d %H:%M:%S')

# GitHub Project
GITHUB_PROJECT_URL="$PROJECT_URL"
PROJECT_OWNER="$PROJECT_OWNER"
PROJECT_NUMBER="$PROJECT_NUMBER"
PROJECT_ID="$PROJECT_ID"

# Status field
STATUS_FIELD_ID="$STATUS_FIELD_ID"

# Status options
STATUS_READY_ID="$READY_ID"
STATUS_WIP_ID="$WIP_ID"
STATUS_REVIEW_ID="$REVIEW_ID"
STATUS_BLOCKED_ID="$BLOCKED_ID"
STATUS_DONE_ID="$DONE_ID"

# Log directory
LOG_DIR="\$HOME/.claude-task/logs"
EOF

log OK "Config saved!"
echo ""
echo "Config file: $CONFIG_FILE"
echo ""
cat "$CONFIG_FILE"
