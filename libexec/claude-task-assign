#!/bin/bash
#
# claude-task assign - Assign an issue to Claude
#
# Usage:
#   claude-task assign <github-issue-url> [options]
#
# Options:
#   --dry-run      Show what would be done
#

set -e

usage() {
  cat <<EOF
Usage: claude-task assign <github-issue-url> [options]

Examples:
  claude-task assign https://github.com/kfly8/repo/issues/42
  claude-task assign https://github.com/kfly8/repo/issues/42 --dry-run

Options:
  --dry-run      Show what would be done
EOF
}

notify() {
  local title="$1"
  local message="$2"
  osascript -e "display notification \"$message\" with title \"$title\"" 2>/dev/null || true
  echo -e "\a"
}

parse_github_url() {
  local url="$1"
  if [[ "$url" =~ github\.com/([^/]+)/([^/]+)/issues/([0-9]+) ]]; then
    OWNER="${BASH_REMATCH[1]}"
    REPO="${BASH_REMATCH[2]}"
    ISSUE_NUM="${BASH_REMATCH[3]}"
    return 0
  fi
  return 1
}

# Convert title to branch-friendly slug
slugify_title() {
  local title="$1"
  local slug

  # Remove labels like [P1], [Bug], etc. from the beginning
  title=$(echo "$title" | sed 's/^\[[^]]*\][[:space:]]*//')

  # Check if title contains non-ASCII characters (Japanese, etc.)
  if echo "$title" | LC_ALL=C grep -q '[^[:print:][:space:]]'; then
    # Translate to English using claude with fast model
    slug=$(echo "$title" | claude -p --model haiku "Translate to a short English branch name slug. Rules: lowercase, use hyphens, no spaces, max 5 words. Output ONLY the slug, nothing else.")
  else
    slug="$title"
  fi

  # Normalize: lowercase, spaces to hyphens, keep only alphanumeric and hyphens, limit length
  echo "$slug" | tr '[:upper:]' '[:lower:]' | tr ' ' '-' | tr -cd 'a-z0-9-' | sed 's/--*/-/g' | sed 's/^-//' | sed 's/-$//' | head -c 50
}

# Parse arguments
ISSUE_URL=""
DRY_RUN=false

while [[ $# -gt 0 ]]; do
  case $1 in
    -h|--help) usage; exit 0 ;;
    --dry-run) DRY_RUN=true; shift ;;
    *) [[ -z "$ISSUE_URL" ]] && ISSUE_URL="$1"; shift ;;
  esac
done

if [[ -z "$ISSUE_URL" ]]; then
  usage
  exit 1
fi

if ! parse_github_url "$ISSUE_URL"; then
  log ERROR "Invalid GitHub Issue URL: $ISSUE_URL"
  exit 1
fi

FULL_REPO="${OWNER}/${REPO}"

# Find repo with ghq
GHQ_ROOT=$(ghq root)
REPO_PATH="${GHQ_ROOT}/github.com/${OWNER}/${REPO}"

if [[ ! -d "$REPO_PATH" ]]; then
  log ERROR "Repository not found: $REPO_PATH"
  log INFO "Run: ghq get $FULL_REPO"
  exit 1
fi

# Check if git-wo is available
if ! command -v git-wo >/dev/null 2>&1; then
  log ERROR "git-wo is not installed or not in PATH"
  log INFO "Install from: https://github.com/kfly8/git-wo"
  exit 1
fi

# Get worktree root from git config (expand ~ to $HOME)
WORKTREE_ROOT=$(cd "$REPO_PATH" && git config --get wo.root 2>/dev/null | sed "s|^~|$HOME|")
if [[ -z "$WORKTREE_ROOT" ]]; then
  WORKTREE_ROOT="$HOME/worktree"
fi

log INFO "Fetching Issue #${ISSUE_NUM} from ${FULL_REPO}..."

ISSUE_JSON=$(gh issue view "$ISSUE_NUM" --repo "$FULL_REPO" --json title,body,url)
ISSUE_TITLE=$(echo "$ISSUE_JSON" | jq -r '.title')
ISSUE_BODY=$(echo "$ISSUE_JSON" | jq -r '.body // ""')

if [[ -z "$ISSUE_TITLE" ]] || [[ "$ISSUE_TITLE" == "null" ]]; then
  log ERROR "Could not fetch issue #${ISSUE_NUM}"
  exit 1
fi

log OK "Found: $ISSUE_TITLE"

# Generate branch name from issue number and title
TITLE_SLUG=$(slugify_title "$ISSUE_TITLE")
if [[ -n "$TITLE_SLUG" ]]; then
  BRANCH_NAME="issue-${ISSUE_NUM}-${TITLE_SLUG}"
else
  BRANCH_NAME="issue-${ISSUE_NUM}"
fi
WORKTREE_PATH="${WORKTREE_ROOT}/github.com/${OWNER}/${REPO}/${BRANCH_NAME}"

log INFO "Branch: $BRANCH_NAME"

if [[ "$DRY_RUN" == true ]]; then
  echo ""
  echo "=== DRY RUN ==="
  echo "URL:        $ISSUE_URL"
  echo "Repo:       $FULL_REPO"
  echo "Issue:      #$ISSUE_NUM - $ISSUE_TITLE"
  echo "Branch:     $BRANCH_NAME"
  echo "Local:      $REPO_PATH"
  echo "Worktree:   $WORKTREE_PATH"
  exit 0
fi

if [[ -d "$WORKTREE_PATH" ]]; then
  log WARN "Worktree already exists: $WORKTREE_PATH"
  read -p "Remove and recreate? [y/N] " -n 1 -r
  echo
  if [[ $REPLY =~ ^[Yy]$ ]]; then
    cd "$REPO_PATH"
    git wo remove "$WORKTREE_PATH" --force 2>/dev/null || true
  else
    log INFO "Using existing worktree"
  fi
fi

if [[ ! -d "$WORKTREE_PATH" ]]; then
  log INFO "Creating worktree: $BRANCH_NAME"
  cd "$REPO_PATH"
  git fetch origin

  # Determine base branch
  BASE_BRANCH="main"
  if ! git rev-parse --verify origin/main >/dev/null 2>&1; then
    if git rev-parse --verify origin/master >/dev/null 2>&1; then
      BASE_BRANCH="master"
    fi
  fi

  # Create worktree using git-wo with -C to specify main directory
  GIT_WO_OUTPUT=$(git wo -C "$REPO_PATH" add "$BRANCH_NAME" "origin/$BASE_BRANCH" 2>&1)
  echo "$GIT_WO_OUTPUT"

  # Extract path from "Created: <path>" line and expand ~
  WORKTREE_PATH=$(echo "$GIT_WO_OUTPUT" | grep "^Created:" | sed 's/^Created: //' | sed "s|^~|$HOME|")
fi

cd "$WORKTREE_PATH"
log OK "Worktree ready: $WORKTREE_PATH"

CLAUDE_PROMPT="## Task
Repository: ${FULL_REPO}
Issue #${ISSUE_NUM}: ${ISSUE_TITLE}
URL: ${ISSUE_URL}

## Description
${ISSUE_BODY}

## Instructions

### Preparation
1. Read CLAUDE.md if exists for project conventions and architectural decisions.
2. Check existing codebase patterns first — grep for similar implementations in other components and match them exactly.

### Implementation
3. Always fix root causes, never add workarounds — if you find yourself patching symptoms, stop and re-analyze. Trace the issue to its source and fix it there. If you're unsure of the root cause, say so before writing code.
4. Implement the fix/feature described above. For independent packages or modules, use Task to spawn parallel sub-agents that work simultaneously.
5. Write tests if applicable.
6. Run the full test suite (including e2e if available) after each significant change — not just at the end.
7. If tests fail, diagnose the root cause and fix. Try at least 3 different approaches before asking for help.

### Review
8. Self-review: re-read CLAUDE.md and verify each change aligns with conventions. If anything violates a principle, fix it before proceeding.
9. Check if README or docs need updates for version requirements or breaking changes.
10. List any decisions you made that aren't covered by CLAUDE.md (so it can be updated later).

### Delivery
11. Commit with clear message referencing #${ISSUE_NUM}.
12. Push to origin/${BRANCH_NAME} — do NOT push until all tests pass.
13. Create PR with a clear description mapping changes to the issue requirements, including 'Closes #${ISSUE_NUM}' in the body.
14. If CI fails on the PR, fix it and push again. Only consider the task done when the PR is green."

CLAUDE_CMD="claude --permission-mode plan"

log INFO "Starting Claude Code..."
echo ""
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo "Issue:     #${ISSUE_NUM} - ${ISSUE_TITLE}"
echo "Worktree:  ${WORKTREE_PATH}"
echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
echo ""

$CLAUDE_CMD "$CLAUDE_PROMPT"

log OK "Claude session ended"
